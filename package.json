{
  "name": "@gscalzo/stackoverflow-mcp",
  "version": "0.2.0",
  "description": "A MCP server for querying Stack Overflow.",
  "author": "Giordano Scalzo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gscalzo/stackoverflow-mcp"
  },
  "keywords": [
    "mcp",
    "stackoverflow",
    "ai",
    "search",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./build/server.js",
  "types": "./build/server.d.ts",
  "exports": {
    ".": {
      "types": "./build/server.d.ts",
      "import": "./build/server.js"
    },
    "./index.js": "./build/index.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "stackoverflow-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "!build/__tests__"
  ],
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('build/index.js', 0o755);\"",
    "prepack": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.js\" \"*.json\"",
    "smoke": "node scripts/smoke.mjs",
    "test:live": "node scripts/live-check.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.3.0",
    "jest-ts-webcompat-resolver": "^1.0.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
